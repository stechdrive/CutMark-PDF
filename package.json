{
  "homepage": "https://stechdrive.github.io/CutMark-PDF/",
  "name": "cutmark-pdf",
  "private": true,
  "version": "2.6.2",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "vite",
    "build": "npm run build:web",
    "build:web": "vite build --mode web",
    "build:tauri": "vite build --mode tauri",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run lint && npm run typecheck && npm run test:run && npm run build:web && npm run audit:dist",
    "check:desktop": "npm run lint && npm run typecheck && npm run test:run && npm run tauri:build && npm run audit:release",
    "preview": "npm run preview:web",
    "preview:web": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "powershell -ExecutionPolicy Bypass -File scripts/build-tauri-release.ps1",
    "audit:dist": "powershell -ExecutionPolicy Bypass -File scripts/audit-release-artifacts.ps1 -SkipArtifactCheck",
    "audit:release": "powershell -ExecutionPolicy Bypass -File scripts/audit-release-artifacts.ps1",
    "release:windows": "npm run tauri:build && npm run release:assets && npm run audit:release && npm run release:checksums",
    "release:assets": "powershell -ExecutionPolicy Bypass -File scripts/create-windows-release-assets.ps1",
    "release:checksums": "powershell -ExecutionPolicy Bypass -File scripts/create-windows-checksums.ps1",
    "screenshot:readme": "powershell -ExecutionPolicy Bypass -File scripts/create-readme-screenshot.ps1",
    "predeploy": "npm run build:web && npm run audit:dist",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "client-zip": "^2.5.0",
    "lucide-react": "^0.554.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "5.4.296",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-pdf": "^10.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.4",
    "baseline-browser-mapping": "^2.10.20",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "gh-pages": "^6.3.0",
    "globals": "^17.0.0",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.53.0",
    "vite": "^6.2.0",
    "vite-plugin-static-copy": "^4.0.1",
    "vitest": "^4.1.4"
  }
}
